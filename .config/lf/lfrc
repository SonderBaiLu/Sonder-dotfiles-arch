# lf 主配置（终端文件管理器）。
# 预览器见 preview.sh：图片/视频用 chafa 出彩色块，文本 / PDF / 压缩包直接列内容。

set preview on
set previewer ~/.config/lf/preview.sh

# 三栏宽度：父目录 : 当前目录 : 预览
set ratios 1:3:4

# 显示隐藏文件；目录内容变化后 1 秒内自动刷新
set hidden on
set period 1

# 底部信息栏显示文件大小与修改时间
set info size:time

# 边框与光标上下留白
set drawbox on
set scrolloff 10

# 打开文件用系统默认程序（OPENER 默认即 xdg-open），编辑用 $EDITOR（Hyprland 已注入 nvim）
