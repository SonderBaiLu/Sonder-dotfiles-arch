[Unit]
Description=frpc (Sonder.MC tunnel)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/sbin/frpc -c %h/.config/frpc/frpc.toml
Restart=always
RestartSec=5
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
