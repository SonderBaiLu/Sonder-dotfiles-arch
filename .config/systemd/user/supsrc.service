[Unit]
Description=supsrc auto-sync daemon
Documentation=https://github.com/orenlab/supsrc
After=network-online.target
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=%h/.local/bin/supsrc watch -c %h/.config/supsrc/supsrc.conf
Restart=always
RestartSec=10
TimeoutStopSec=15
Environment=HOME=%h
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
