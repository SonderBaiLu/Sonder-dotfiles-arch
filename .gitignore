# 本地覆盖
*.local
# 放行 XDG 用户目录 .local/（*.local 的 glob 会误伤目录名本身），
# 其内容是否入库由下方 .local/share/* 规则链决定
!.local/
*.local.toml

# 缓存
.cache/
# .local/share 整体不入库（wine 扩展等运行时垃圾重灾区），
# 仅白名单放行手工维护的 XDG 启动器覆盖项
.local/share/*
!.local/share/applications/
.local/share/applications/*
!.local/share/applications/firefox.desktop

# 日志
*.log

# 备份文件
*.bak-*

# fcitx5 运行时缓存（每次启动按当前键盘布局重新生成）
.config/fcitx5/conf/cached_layouts

# Rust 构建产物
installer/target/
tools/*/target/

# 敏感信息，千万别提交
.ssh/id_*
*.token
secrets*
!secrets.fish.example
.aider*

# mimosa（安全扫描工具）的会话状态与报告，纯运行时产物
.mimosa/

# LibreOffice：只跟踪 user/config（Catppuccin 调色板等用户数据），
# registrymodifications.xcu 是随每次运行改写的运行时状态，体积大且含最近文档记录
.config/libreoffice/*
!.config/libreoffice/4
.config/libreoffice/4/*
!.config/libreoffice/4/user
.config/libreoffice/4/user/*
!.config/libreoffice/4/user/config

# systemd：只跟踪用户单元文件本体；*.wants 链接目录与
# pipewire-session-manager.service 会话别名由 systemctl 自动生成
.config/systemd/user/*.wants/
.config/systemd/user/pipewire-session-manager.service
# 个人服务单元只留在本机，不入库
.config/systemd/user/ollama.service
.config/systemd/user/openclaw-gateway.service

# VLC：界面布局状态随窗口变动，不跟踪（vlcrc 中的硬解修复才需要入库）
.config/vlc/vlc-qt-interface.conf
